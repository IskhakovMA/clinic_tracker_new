# Скопируйте в .env и заполните. НИКОГДА не коммитьте настоящий .env — он в .gitignore.
#
# Приложение и CLI НЕ читают .env сами: настройки берутся только из окружения
# процесса. Загрузите файл одним способом:
#   systemd:  EnvironmentFile=/путь/к/.env
#   uvicorn:  python -m uvicorn backend.app.main:app --env-file backend/.env ...
#   shell:    set -a; . backend/.env; set +a      (нужно и для CLI-команд)
# Если backend/.env существует, но его значения не попали в окружение (или
# отличаются), сервер не стартует, а CLI завершается с кодом 2.
# Формат: ИМЯ=значение, комментарии строкой с #, без комментариев в конце строки.

# Общего пароля приложения больше нет: у каждого сотрудника — своя учётная
# запись. Первый Разработчик создаётся командой (пароль вводится скрыто):
#   python -m backend.cli create-developer

# Хост и порт. По умолчанию слушаем только localhost — не меняйте HOST
# на 0.0.0.0 без HTTPS reverse proxy (см. README, раздел Production).
# Адрес прослушивания задают аргументы uvicorn --host/--port; CLINIC_HOST —
# доверенный Host (должен совпадать с --host), CLINIC_PORT — справочно.
CLINIC_HOST=127.0.0.1
CLINIC_PORT=8420

# true только когда приложение реально работает за HTTPS
# (включает Secure-флаг cookie и HSTS).
CLINIC_HTTPS=false

# Отладочный режим: подробные логи + /api/docs. Выключен по умолчанию.
CLINIC_DEBUG=false

# Срок жизни сессии в секундах (по умолчанию 8 часов).
CLINIC_SESSION_TTL_SECONDS=28800

# Каталог данных (SQLite-база и резервные копии). По умолчанию backend/data.
# CLINIC_DATA_DIR=/path/to/data

# Encrypted backups fail closed without a key. Create a protected key file with:
#   python -m backend.cli backup-keygen /secure/offline/location/clinic-backup.key
# Store the real key outside Git, outside DB/data directories, and outside
# backup directories. Do not paste a working key here.
# CLINIC_BACKUP_KEY_FILE=/secure/offline/location/clinic-backup.key
# key_id хранится в файле ключа (backup-keygen --key-id); переменная нужна только
# для старых однострочных файлов и не должна отличаться от записанного id.
# CLINIC_BACKUP_KEY_ID=operator-managed-key-id

# Подпись выгрузок пациентов (HMAC-SHA256). Отдельный ключ, не ключ резервных
# копий; 32 байта (base64url/hex), файл с правами только владельца. Без ключа
# экспорт недоступен. Прежние ключи этой установки — только для проверки.
# CLINIC_EXPORT_SIGNING_KEY_FILE=/secure/offline/location/clinic-export-signing.key
# CLINIC_EXPORT_SIGNING_KEY_ID=operator-managed-export-key-id
# CLINIC_EXPORT_VERIFY_KEYS={"previous-export-key-id": "<retired key, never commit real values>"}

# Read-only AI Assistant V1. Disabled by default. Use only a local/internal
# OpenAI-compatible endpoint; never commit real API keys or model files.
CLINIC_AI_ENABLED=false
CLINIC_AI_BASE_URL=http://127.0.0.1:1234/v1
CLINIC_AI_MODEL=
# CLINIC_AI_API_KEY=
CLINIC_AI_TIMEOUT_SECONDS=45
CLINIC_AI_MAX_OUTPUT_TOKENS=1200
CLINIC_AI_MAX_TOOL_CALLS=8
CLINIC_AI_MAX_HISTORY_MESSAGES=12
CLINIC_AI_MAX_USER_MESSAGE_CHARS=4000
CLINIC_AI_RATE_LIMIT_REQUESTS=30
CLINIC_AI_RATE_LIMIT_WINDOW_SECONDS=300

# Онкоконсилиум: лимиты на пользователя и адрес клиента за окно (секунды).
# CLINIC_CONSILIUM_RATE_LIMIT_WINDOW_SECONDS=60
# CLINIC_CONSILIUM_WRITE_RATE_LIMIT=60
# CLINIC_CONSILIUM_EXPORT_RATE_LIMIT=20
# CLINIC_CONSILIUM_SCHEDULE_RATE_LIMIT=20

# WP-G: no real/remote medical AI transfer. Synthetic local stub only, explicit exact allowlist.
CLINIC_AI_DATA_MODE=disabled
CLINIC_AI_SYNTHETIC_ALLOWLIST=
