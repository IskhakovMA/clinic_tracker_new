# Скопируйте в .env (или экспортируйте в окружение) и заполните.
# НИКОГДА не коммитьте настоящий .env — он в .gitignore.

# Первоначальный пароль приложения. Используется ТОЛЬКО при первом запуске,
# если пароль ещё не задан; после этого хранится только Argon2id-хеш в БД.
# Рекомендуемый способ задать/сменить пароль: python -m backend.cli set-password
CLINIC_ADMIN_PASSWORD=

# Хост и порт. По умолчанию слушаем только localhost — не меняйте HOST
# на 0.0.0.0 без HTTPS reverse proxy (см. README, раздел Production).
CLINIC_HOST=127.0.0.1
CLINIC_PORT=8420

# true только когда приложение реально работает за HTTPS
# (включает Secure-флаг cookie и HSTS).
CLINIC_HTTPS=false

# Отладочный режим: подробные логи + /api/docs. Выключен по умолчанию.
CLINIC_DEBUG=false

# Срок жизни сессии в секундах (по умолчанию 8 часов).
CLINIC_SESSION_TTL_SECONDS=28800

# Каталог данных (SQLite-база и резервные копии). По умолчанию backend/data.
# CLINIC_DATA_DIR=/path/to/data
